# --- targets ---
HOSTS=1.1.1.1,8.8.8.8,cloudflare.com
# HOSTS_FILE=/etc/telegraf/netprobe.hosts   # optional: one target per line

# --- global and per-probe intervals (ms) ---
INTERVAL_MS=200        
F_INTERVAL_MS=
TCP_INTERVAL_MS=
UDP_INTERVAL_MS=

# --- fping tuning ---
FPING_COUNT=20
FPING_TIMEOUT_MS=1000
FPING_SIZE=56
# FPING_SOURCE=
# FPING_EXTRA

# ---- InfluxDB init  ----
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=Ver#Sdr0nkP@zzv0rt
DOCKER_INFLUXDB_INIT_ORG=netprobe
DOCKER_INFLUXDB_INIT_BUCKET=netprobe
DOCKER_INFLUXDB_INIT_RETENTION=30d
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=bb10eefa939ebf91997394926e47a4f2cf65255432776a67ff611decbafffe46

# --- Telegraf exec scheduling (independent of *_INTERVAL_MS above) ---
ICMP_INTERVAL=10s
ICMP_TIMEOUT=6s

INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=***REPLACE*** # do not commit real token
INFLUX_ORG=netprobe
INFLUX_BUCKET=netprobe

PROBE_NAME=vm1
PROBE_REGION=il
PROBE_SITE=lab1

GF_SECURITY_ADMIN_USER: admin
GF_SECURITY_ADMIN_PASSWORD: admin
GF_USERS_DEFAULT_THEME: dark

EGRESS_GATEWAY=
